+struct DispatchSpy {
+    calls: Arc<AtomicUsize>,
+}
+
+impl CoreToolExecutor<ToolInvocation> for DispatchSpy {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain("recipe_only_spy")
+    }
+
+    fn spec(&self) -> ToolSpec {
+        ToolSpec::Function(codex_tools::ResponsesApiTool {
+            name: "recipe_only_spy".to_string(),
+            description: "test spy".to_string(),
+            strict: false,
+            defer_loading: None,
+            parameters: codex_tools::JsonSchema::default(),
+            output_schema: None,
+        })
+    }
+
+    fn handle<'a>(&'a self, _invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        Box::pin(async {
+            Ok(Box::new(FunctionToolOutput::from_text(
+                "called".to_string(),
+                Some(true),
+            )) as Box<dyn ToolOutput>)
+        })
+    }
+}
+
+impl CoreToolRuntime for DispatchSpy {}

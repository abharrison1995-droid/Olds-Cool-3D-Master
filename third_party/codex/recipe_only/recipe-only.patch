+#[tokio::test]
+async fn recipe_only_dispatch_fails_fatally_before_registered_handler() {
+    let (session, turn) = make_session_and_context().await;
+    let step_context = StepContext::for_test(Arc::new(turn));
+    let calls = Arc::new(AtomicUsize::new(0));
+    let handler = Arc::new(DispatchSpy {
+        calls: Arc::clone(&calls),
+    });
+    let spec = handler.spec();
+    let runtime: Arc<dyn CoreToolRuntime> = handler;
+    let mut router = ToolRouter::from_parts(
+        ToolRegistry::from_tools([runtime]),
+        vec![spec],
+        ToolMode::Direct,
+        BTreeMap::new(),
+        None,
+        &[],
+    );
+    router.recipe_only = true;
+    let call = ToolCall {
+        tool_name: ToolName::plain("recipe_only_spy"),
+        call_id: "call-spy".to_string(),
+        payload: ToolPayload::Function {
+            arguments: "{}".to_string(),
+        },
+        encrypted_function_args: None,
+    };
+
+    let result = router
+        .dispatch_tool_call_with_code_mode_result(
+            Arc::new(session),
+            step_context,
+            CancellationToken::new(),
+            Arc::new(tokio::sync::Mutex::new(TurnDiffTracker::new())),
+            call,
+            ToolCallSource::Direct,
+        )
+        .await;
+    let error = match result {
+        Err(error) => error,
+        Ok(_) => panic!("recipe-only must reject dispatch"),
+    };
+
+    assert!(matches!(
+        error,
+        crate::function_tool::FunctionCallError::Fatal(_)
+    ));
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+}

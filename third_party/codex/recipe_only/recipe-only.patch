+            tool_runtimes: vec![mcp_runtime(
+                "test-server",
+                "mcp__test__",
+                "external_escape",
+                ToolExposure::Direct,
+            )],
+            tool_suggest_candidates: Some(plugin_candidates(ToolSuggestPresentation::ListTool)),
+            extension_tool_executors: vec![Arc::new(TestNamespaceExtensionTool {
+                namespace: "extension/",
+                tool_name: "escape",
+            })],
+            dynamic_tools: vec![dynamic_tool(None, "dynamic_escape", false)],
+            ..ToolPlanInputs::default()
+        },
+    ));
+
+    assert!(router.visible_names.is_empty());
+    assert!(router.registered_names.is_empty());
+    assert!(router.code_mode_tool_names.is_empty());
+    assert!(!router.requires_code_mode_worker);
+    assert_eq!(router.tool_mode, ToolMode::Direct);
+}
